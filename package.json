{
  "name": "idle-driver",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "screenshot": "npm run build && node scripts/screenshot.mjs"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^2.0.5",
    "@types/three": "^0.180.0",
    "pbf": "^4.0.2",
    "playwright": "1.56.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "three": "^0.180.0"
  }
}
